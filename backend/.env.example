# ── Base de données PostgreSQL ───────────────────────────────────────────────
# En local (hors Docker) : utiliser localhost
# En Docker             : utiliser le nom du service (ex: db)
DATABASE_URL=postgresql://admin:SkillMap2026@localhost:5432/skillmap_bd

# ── LLM (CoCalc / compétition) ───────────────────────────────────────────────
LLM_BASE_URL=https://defi-informatique.cocalc.cloud/api
LLM_API_KEY=your_llm_api_key
LLM_COOKIE=your_cocalc_cookie
LLM_MODEL=gpt-oss-ctx24k:120b
LLM_TEMPERATURE=0.1

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Doit correspondre à INTERNAL_API_KEY dans le .env racine (Next.js)
INTERNAL_API_KEY=changeme_internal_key

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]
