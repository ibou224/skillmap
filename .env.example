# ── Base de données PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=SkillMap2026
POSTGRES_DB=skillmap_bd
PGADMIN_EMAIL=admin@gestion-cv.com
PGADMIN_PASSWORD=admin123

# ── Next.js Auth ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=changeme_secret_32_chars_minimum
BETTER_AUTH_SECRET=changeme_secret_32_chars_minimum

# ── Clé partagée Next.js ↔ FastAPI ───────────────────────────────────────────
INTERNAL_API_KEY=changeme_internal_key

# ── LLM (CoCalc / compétition) ───────────────────────────────────────────────
# LLM_BASE_URL  : URL de base de l'API LLM (ex: https://defi-informatique.cocalc.cloud/api)
# LLM_API_KEY   : Clé API OpenAI-compatible
# LLM_COOKIE    : Cookie d'authentification CoCalc (COCALC_COMPUTE_SERVER_AUTH_TOKEN)
# LLM_MODEL     : Modèle à utiliser (défaut : gpt-oss-ctx24k:120b)
LLM_BASE_URL=https://defi-informatique.cocalc.cloud/api
LLM_API_KEY=your_llm_api_key
LLM_COOKIE=your_cocalc_cookie
LLM_MODEL=gpt-oss-ctx24k:120b
