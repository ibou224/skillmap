# =============================================================================
#  Doxyfile — SkillMap (frontend Next.js / React)
# =============================================================================
#  Génération de la documentation à partir des commentaires JSDoc/Doxygen
#  présents dans frontend/src.
#
#  Doxygen ne parse pas nativement le JavaScript/JSX. On utilise donc un filtre
#  d'entrée maison (tools/doxygen-js-filter.js, exécuté avec Node) qui convertit
#  les déclarations annotées en JSDoc en prototypes lisibles par Doxygen.
#
#  Pré-requis : Doxygen (https://www.doxygen.nl/download.html) et Node.js
#  (déjà présent dans ce projet). Aucune dépendance npm supplémentaire.
#
#  Génération (depuis la racine du dépôt) :
#      doxygen Doxyfile
#  La doc HTML est produite dans  docs/doxygen/html/index.html
# =============================================================================

# --- Projet ------------------------------------------------------------------
PROJECT_NAME           = "SkillMap"
PROJECT_BRIEF          = "Plateforme de gestion des CV et d'affectation des professeurs"
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = French
CREATE_SUBDIRS         = NO

# --- Entrée ------------------------------------------------------------------
INPUT                  = frontend/src
RECURSIVE              = YES
FILE_PATTERNS          = *.js *.jsx
EXCLUDE_PATTERNS       = */node_modules/* \
                         */.next/* \
                         */generated/* \
                         */__tests__/* \
                         */test/* \
                         *.test.js \
                         *.test.jsx \
                         *.config.js \
                         *.config.mjs
INPUT_ENCODING         = UTF-8

# --- Filtre JS/JSX -----------------------------------------------------------
#  Convertit le JS/JSX en pseudo-C++ documentable par Doxygen (voir en-tête).
#  Les fichiers sont ensuite analysés avec le parseur C++ de Doxygen.
EXTENSION_MAPPING      = js=C++ jsx=C++
FILTER_PATTERNS        = "*.js=node tools/doxygen-js-filter.js" \
                         "*.jsx=node tools/doxygen-js-filter.js"
FILTER_SOURCE_FILES    = NO

# --- Alias des tags JSDoc personnalisés --------------------------------------
#  Définit les tags JSDoc non standard pour qu'ils soient rendus proprement
#  (et n'émettent plus l'avertissement « Found unknown command »).
ALIASES                = "description=@details" \
                         "route=@par Route:^^" \
                         "access=@par Accès requis:^^" \
                         "body=@par Corps de requête:^^" \
                         "queryParam=@par Paramètre (query):^^" \
                         "type=@par Type:^^" \
                         "hook=@par Hook:^^"

# --- Extraction --------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_JAVA   = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# --- Diagnostics -------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
#  Désactivé : les signatures sont reconstituées par le filtre JS et ne
#  correspondent pas toujours exactement aux @param (faux positifs).
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO

# --- Sortie HTML -------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
SEARCHENGINE           = YES

# --- Sortie LaTeX (désactivée) -----------------------------------------------
GENERATE_LATEX         = NO

# --- Graphes (nécessite Graphviz, désactivé par défaut) ----------------------
HAVE_DOT               = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# --- Index alphabétique ------------------------------------------------------
ALPHABETICAL_INDEX     = YES
