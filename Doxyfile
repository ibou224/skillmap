# =============================================================================
#  Doxyfile — SkillMap (frontend Next.js / React)
# =============================================================================
#  Génération de la documentation à partir des commentaires JSDoc/Doxygen
#  présents dans frontend/src.
#
#  Doxygen ne parse pas nativement le JavaScript/JSX. On utilise donc le filtre
#  d'entrée « doxygen-jsdoc » qui convertit les commentaires JSDoc en une forme
#  compréhensible par Doxygen.
#
#  Pré-requis (une seule fois) :
#      npm install -g doxygen-jsdoc      # ou : npm install --save-dev doxygen-jsdoc
#      (et installer Doxygen : https://www.doxygen.nl/download.html)
#
#  Génération :
#      doxygen Doxyfile
#  La doc HTML est produite dans  docs/doxygen/html/index.html
# =============================================================================

# --- Projet ------------------------------------------------------------------
PROJECT_NAME           = "SkillMap"
PROJECT_BRIEF          = "Plateforme de gestion des CV et d'affectation des professeurs"
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = French
CREATE_SUBDIRS         = NO

# --- Entrée ------------------------------------------------------------------
INPUT                  = frontend/src
RECURSIVE              = YES
FILE_PATTERNS          = *.js *.jsx
EXCLUDE_PATTERNS       = */node_modules/* \
                         */.next/* \
                         */generated/* \
                         */__tests__/* \
                         */test/* \
                         *.test.js \
                         *.test.jsx \
                         *.config.js \
                         *.config.mjs
INPUT_ENCODING         = UTF-8

# --- Filtre JS/JSX -----------------------------------------------------------
#  Convertit le JSDoc en pseudo-code documentable par Doxygen.
#  Nécessite le paquet npm « doxygen-jsdoc » (voir en-tête).
FILTER_PATTERNS        = "*.js=doxygen-jsdoc" \
                         "*.jsx=doxygen-jsdoc"
FILTER_SOURCE_FILES    = NO

# --- Extraction --------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
OPTIMIZE_OUTPUT_JAVA   = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# --- Diagnostics -------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# --- Sortie HTML -------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
SEARCHENGINE           = YES

# --- Sortie LaTeX (désactivée) -----------------------------------------------
GENERATE_LATEX         = NO

# --- Graphes (nécessite Graphviz, désactivé par défaut) ----------------------
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# --- Index alphabétique ------------------------------------------------------
ALPHABETICAL_INDEX     = YES
