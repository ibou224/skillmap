  }

  object "psJS : ProfessorSkill" as psJS {
    professorId    = "prof-001"
    skillId        = "sk-001"
    niveau         = AVANCE
    anneesExp      = 5
    cvExtractionId = "cv-001"
  }

  object "psReact : ProfessorSkill" as psReact {
    professorId    = "prof-001"
    skillId        = "sk-002"
    niveau         = INTERMEDIAIRE
