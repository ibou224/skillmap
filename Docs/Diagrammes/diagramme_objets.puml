    Compétence requise par PROG302
    mais ABSENTE du profil de Marie
    → score individuel Git = 0 %
  end note

}

package "Référentiel Métier" {

  object "progPI : Program" as progPI {
    id       = "prg-001"
    code     = "PI"
    nom      = "Programmation Informatique"
    nbEtapes = 6
  }

  object "courseDW : Course" as courseDW {
    id         = "crs-001"
    code       = "PROG302"
    nom        = "Développement Web Client"
    programId  = "prg-001"
    etape      = 3
    isArchived = false
  }

  object "csJS : CourseSkill" as csJS {
    courseId      = "crs-001"
    skillId       = "sk-001"
    niveauRequis  = AVANCE
    poidsCritique = 5
  }

  object "csReact : CourseSkill" as csReact {
    courseId      = "crs-001"
    skillId       = "sk-002"
    niveauRequis  = INTERMEDIAIRE
    poidsCritique = 3
  }

  object "csGit : CourseSkill" as csGit {
    courseId      = "crs-001"
    skillId       = "sk-003"
    niveauRequis  = DEBUTANT
    poidsCritique = 2
  }

}

package "Session & Affectation" {

  object "sessionA2026 : Session" as sessionA2026 {
    id      = "sess-001"
    nom     = "Automne 2026"
    annee   = 2026
    periode = AUTOMNE
    statut  = ACTIVE
  }

  object "weights : WeightsConfig" as weights {
    id             = "wc-001"
    sessionId      = "sess-001"
    competencesPct = 40
    experiencePct  = 25
    formationPct   = 20
    historiquePct  = 15
  }

  object "assignDupont : Assignment" as assignDupont {
    id          = "asgn-001"
    sessionId   = "sess-001"
    professorId = "prof-001"
    courseId    = "crs-001"
    score       = 78.00
    scoreDetail = {competences:80.0, experience:60.0,
                   formation:80.0, historique:100.0}
    statut      = PROPOSEE
    updatedById = null
  }

  note right of assignDupont
    Calcul du score :
    ① Compétences :
       JS   (AVANCE>=AVANCE)    100% × 5 =  500
       React(INTERM>=INTERM)    100% × 3 =  300
       Git  (absent)              0% × 2 =    0
       → (500+300+0)/(5+3+2) = 80.0 %
    ② Expérience :
       exp1 = 3 ans 9 mois ≈ 4 ans
       exp2 = 1 an 9 mois  ≈ 2 ans
       → min(6/10,1)×100   = 60.0 %
    ③ Formation : MAITRISE      = 80.0 %
    ④ Historique : déjà enseigné= 100.0 %
    Score = (80×0.40)+(60×0.25)
          + (80×0.20)+(100×0.15)
          = 32+15+16+15 = 78.00
  end note

}

